# ============================================================================
# 星火商城 SparkMall 环境变量模板
# 用法: 复制为 .env(已被 .gitignore 忽略) 或直接在 IDEA / shell 中注入环境变量
# 注意: 本文件仅保留变量名与示例占位, 请勿把真实密码写进仓库
# ============================================================================

# --- MySQL ---
# 数据库连接串(默认指向本机 spark_mall 库)
DB_URL=jdbc:mysql://localhost:3306/spark_mall?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# --- RabbitMQ (order-service 延迟队列) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change-me

# --- JWT 签名密钥 ---
# 必须 >= 32 字节(256bit), 且 gateway-service 与 user-service 使用同一个值
# 生成示例: openssl rand -base64 48
JWT_SECRET=please-generate-a-random-secret-at-least-32-bytes
